<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Google Sign-In IDs come from server/.env via `make sim` / `make phone` (see README).
	     Empty means the Connect Google button explains it is not set up. -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- The server's Web client ID, so sign-in returns a serverAuthCode. -->
	<key>GIDServerClientID</key>
	<string>$(GOOGLE_WEB_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- The iOS client ID reversed, e.g. com.googleusercontent.apps.1234-abcd -->
				<string>$(GOOGLE_IOS_URL_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<!-- Invite links open twin://invite/<code> from the server's /i/<code> page. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>twin</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>PlusJakartaSans-Regular.ttf</string>
		<string>PlusJakartaSans-Medium.ttf</string>
		<string>PlusJakartaSans-SemiBold.ttf</string>
		<string>PlusJakartaSans-Bold.ttf</string>
		<string>PlusJakartaSans-ExtraBold.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets the app reach the server over plain http on localhost or the LAN. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CloseMates suggests places near you, and shows you on the Map only to the circles you choose.</string>
	<!-- Background App Refresh: iOS wakes Twin now and then to check for nudges and surprises. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.sendtovishnu.hacktx26.twin.refresh</string>
	</array>
	<key>NSContactsUsageDescription</key>
	<string>CloseMates checks which of your contacts are on CloseMates so you can add them. Your contacts aren't stored.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CloseMates connects to your team's demo server on this Wi-Fi network.</string>
	<!-- Set at build time by `make sim` / `make phone`. Empty means start in mock mode. -->
	<key>TwinServerURL</key>
	<string>$(TWIN_SERVER_URL)</string>
</dict>
</plist>
