# Postgres connection string required for `npm run db:reset` and real routes.
# Example: postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
# Without DATABASE_URL, db:reset fails fast with a clear error — that is expected.
DATABASE_URL=

# Gemini (Person B). Demo default model name from team:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini

# Meta Muse Spark (Person B). META_MODEL is required for Muse; not in the original plan list.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# SerpApi (Person B)
SERPAPI_KEY=

# Google OAuth Web client (Person A) — leave empty to use ICS/mock ingest stubs
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# false = hit Postgres + AI stubs/real providers; true = JSON fixtures only
USE_MOCKS=false
DEMO_LOCATION=PCL Library, UT Austin
PORT=3000
