# Postgres connection string required for `npm run db:reset` (and later real routes).
# Example: postgresql://postgres:postgres@localhost:5432/hacktx26
# Without DATABASE_URL, db:reset fails fast with a clear error — that is expected.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=gemini
META_API_KEY=
META_API_BASE_URL=
SERPAPI_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
USE_MOCKS=true
DEMO_LOCATION=PCL Library UT Austin
PORT=3000
